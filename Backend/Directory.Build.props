<Project>

  <!--
    Settings shared by EVERY project in the solution.
    Change here once instead of in six .csproj files.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Warnings become errors in Release only, so a broken build never reaches the factory. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- Nullable mistakes are always errors: they are the ones that crash at 2am. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) to run at build time. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: we do not require an XML comment on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Colors Company for Paper and Plastic Industries</Company>
    <Product>Colors ERP</Product>
    <Authors>Colors ERP</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
