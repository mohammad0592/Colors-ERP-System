# Normalise line endings so Windows and Linux never fight over them.
# Without this, a file saved on Windows shows as "every line changed".

* text=auto eol=lf

# Windows-only files keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.sln      text eol=crlf

# Binary — never touch
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.xlsx     binary
*.xls      binary
*.docx     binary
*.zip      binary
*.dll      binary
*.exe      binary
*.woff     binary
*.woff2    binary
